<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 1591: missing XML doc comment. We document the public surface but do
         not require a comment on every member during the initial port. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <PackageId>BullMQ</PackageId>
    <Authors>Taskforce.sh Inc.</Authors>
    <Company>Taskforce.sh Inc.</Company>
    <Product>BullMQ</Product>
    <Description>The fastest, most reliable, Redis-based (and PostgreSQL-based) distributed queue for .NET. Carefully written for rock solid stability and atomicity, sharing the same Lua/SQL scripts as the reference Node.js implementation.</Description>
    <PackageTags>queue;redis;postgres;jobs;worker;bullmq;background-jobs;distributed</PackageTags>
    <PackageProjectUrl>https://bullmq.io</PackageProjectUrl>
    <RepositoryUrl>https://github.com/taskforcesh/bullmq</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Version is stamped by the release pipeline; keep a dev default here. -->
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" Version="2.8.24" />
    <PackageReference Include="Npgsql" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BullMQ.Tests" />
  </ItemGroup>

  <!-- The shared, pre-flattened Lua command scripts are copied from the
       repository root `rawScripts/` folder into `Commands/` by the
       `copy:lua:dotnet` step and embedded into the assembly so the package is
       self-contained. They are the single source of truth shared with every
       other BullMQ runtime. -->
  <ItemGroup>
    <EmbeddedResource Include="Commands/**/*.lua" />
  </ItemGroup>

  <!-- The shared PostgreSQL schema/commands are copied from `src/postgres` into
       `Postgres/` by the `copy:sql:dotnet` step and embedded into the assembly.
       Same single source of truth as every other runtime's SQL backend. -->
  <ItemGroup>
    <EmbeddedResource Include="Postgres/**/*.sql" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)../../README.md')">
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
